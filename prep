"The Proposal"
]],
["First Flight – Poems",[
"Dust of Snow","Fire and Ice","A Tiger in the Zoo",
"How to Tell Wild Animals","The Ball Poem","Amanda!",
"The Trees","Fog","The Tale of Custard the Dragon",
"For Anne Gregory"
]],
["Footprints Without Feet",[
"A Triumph of Surgery","The Thief's Story",
"The Midnight Visitor","A Question of Trust",
"Footprints Without Feet","The Making of a Scientist",
"The Necklace","Bholi","The Book That Saved the Earth"
]],
["Grammar and Writing",[
"Determiners","Tenses","Modals","Subject–Verb Concord",
"Reported Speech – Commands and Requests",
"Reported Speech – Statements",
"Reported Speech – Questions",
"Formal Letter Writing","Analytical Paragraph Writing",
"Unseen Reading Passages"
]]
]},

{
code:"119",name:"Sanskrit – मणिका",date:"1 March 2027",
icon:"अ",color:"#b36b79",
groups:[

["पाठ्यपुस्तकम् – मणिका भाग २",[
"पाठ १ – वाङ्मयं तपः",
"पाठ २ – नास्ति त्यागसमं सुखम्",
"पाठ ३ – रमणीया हि सृष्टिः एषा",
"पाठ ४ – आज्ञा गुरूणां हि अविचारणीया",
"पाठ ५ – अभ्यासवशगं मनः",
"पाठ ६ – राष्ट्रं संरक्ष्यमेव हि",
"पाठ ७ – साधुवृत्तिं समाचरेत्",
"पाठ ८ – तिरुक्कुरल्-सूक्ति-सौरभम्",
"पाठ ९ – सुस्वागतं भो! अरुणाचलेऽस्मिन्",
"पाठ १० – कालोऽहम् (आन्तरिक मूल्यांकन)",
"पाठ ११ – किं किम् उपादेयम् (आन्तरिक मूल्यांकन)"
]],

["व्याकरणम्",[
"सन्धिः – स्वर, व्यञ्जन, विसर्ग",
"समासः – तत्पुरुष, द्वन्द्व, अव्ययीभाव",
"प्रत्ययाः – कृत्, तद्धित, स्त्री-प्रत्यय",
"वाच्यपरिवर्तनम्","समयलेखनम्",
"अव्ययपदानि","अशुद्धि-संशोधनम्"
]],

["रचनात्मककार्यम्",[
"पत्रलेखनम्","चित्रवर्णनम्",
"अनुच्छेदलेखनम्","संस्कृतभाषया वाक्यरचना / अनुवादः"
]],

["अपठित-अवबोधनम्",[
"अपठितगद्यांशस्य पठनम्",
"गद्यांशाधारित प्रश्नोत्तराणि",
"शब्दार्थ / पर्याय / विलोम चयनम्",
"शीर्षक-निर्धारणम्"
]]
]},

{
code:"087",name:"Social Science",date:"8 March 2027",
icon:"◎",color:"#458a91",
groups:[
["History",[
"The Rise of Nationalism in Europe",
"Nationalism in India",
"The Making of a Global World – prescribed board subtopics",
"Print Culture and the Modern World",
"The Age of Industrialisation – periodic assessment only"
]],
["Geography",[
"Resources and Development",
"Forest and Wildlife Resources","Water Resources",
"Agriculture","Minerals and Energy Resources",
"Manufacturing Industries",
"Lifelines of National Economy – map pointing only"
]],
["Civics",[
"Power-sharing","Federalism",
"Gender, Religion and Caste",
"Political Parties","Outcomes of Democracy"
]],
["Economics",[
"Development","Sectors of the Indian Economy",
"Money and Credit",
"Globalisation and the Indian Economy",
"Consumer Rights – project work"
]]
]}
];

// Progress storage
let state={};
try{
 state=JSON.parse(localStorage.getItem("class10tracker2027")||"{}");
}catch(e){}

let current=0;
let activeGroup=0;

function key(s,g,i,t){
 return `${s}-${g}-${i}-${t}`;
}

function save(){
 localStorage.setItem("class10tracker2027",JSON.stringify(state));
}

function counts(s){
 let total=0,done=0;
 subjects[s].groups.forEach((g,gi)=>{
  g[1].forEach((x,i)=>{
   total++;
   if(state[key(s,gi,i,"d")])done++;
  });
 });
 return {total,done,pct:total?
 Math.round(done/total*100):0};
}

function renderHome(){
 let total=0,done=0;
 subjects.forEach((s,i)=>{
  let c=counts(i);
  total+=c.total;
  done+=c.done;
 });
 let p=Math.round(done/total*100);

 document.getElementById("overall").textContent=p+"%";
 document.getElementById("counts").textContent=done+"/"+total;
 document.getElementById("overallbar").style.width=p+"%";

 document.getElementById("subjects").innerHTML=
 subjects.map((s,i)=>{
  let c=counts(i);
  return `
  <button class="subject" data-sub="${i}">
   <div class="top">
    <div class="ico" style="background:${s.color}">${s.icon}</div>
    <div>
     <div class="name">${s.name}
      <span class="code">${s.code}</span>
     </div>
     <div class="date">${s.date}</div>
    </div>
    <div class="percent">${c.pct}%</div>
   </div>
   <div class="track">
    <div class="fill" style="width:${c.pct}%"></div>
   </div>
  </button>`;
 }).join("");

 document.querySelectorAll("[data-sub]").forEach(b=>{
  b.onclick=()=>openSubject(+b.dataset.sub);
 });
}

function openSubject(i){
 current=i;
 activeGroup=0;
 document.getElementById("dashboard").style.display="none";
 document.getElementById("detail").style.display="block";
 renderDetail();
 window.scrollTo(0,0);
}

function renderDetail(){
 let s=subjects[current];
 let c=counts(current);

 document.getElementById("subjecttitle").textContent=s.name;
 document.getElementById("subjectmeta").textContent=
 `Subject code ${s.code} • Examination: ${s.date}`;
 document.getElementById("subjectpercent").textContent=c.pct+"% complete";
 document.getElementById("subjectcount").textContent=
 `${c.done} of ${c.total} topics`;
 document.getElementById("subjectbar").style.width=c.pct+"%";

 document.getElementById("tabs").innerHTML=
 s.groups.map((g,i)=>`
 <button class="tab ${i===activeGroup?"active":""}"
 data-g="${i}">${g[0]}</button>`).join("");

 document.querySelectorAll("[data-g]").forEach(b=>{
  b.onclick=()=>{
   activeGroup=+b.dataset.g;
   renderDetail();
  };
 });

 let g=s.groups[activeGroup];
 document.getElementById("categorytitle").textContent=g[0];

 document.getElementById("topics").innerHTML=
 g[1].map((n,i)=>{
  let d=!!state[key(current,activeGroup,i,"d")];
  let r=!!state[key(current,activeGroup,i,"r")];

  return `
  <div class="topic ${d?"done":""}">
   <label>
    <input type="checkbox" data-i="${i}" data-t="d"
    ${d?"checked":""}>
    <span class="topicname">${n}</span>
   </label>
   <label class="revision">
    <input type="checkbox" data-i="${i}" data-t="r"
    ${r?"checked":""}>
    Revision completed
   </label>
  </div>`;
 }).join("");

 document.querySelectorAll("#topics input").forEach(el=>{
  el.onchange=()=>{
   state[key(current,activeGroup,+el.dataset.i,el.dataset.t)]
   =el.checked;
   save();
   renderDetail();
  };
 });
}

document.getElementById("back").onclick=()=>{
 document.getElementById("detail").style.display="none";
 document.getElementById("dashboard").style.display="block";
 renderHome();
 window.scrollTo(0,0);
};

renderHome();

</script>
</body>
</html>
