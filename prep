
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Class 10 Board Exam Tracker</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#f3f5f8;color:#263b55;
 font:15px/1.5 Arial,sans-serif
}
header{
 background:#172b46;color:white;padding:25px 20px;
 text-align:center
}
header h1{margin:8px;font-size:30px}
header p{color:#d5e0ef}
main{max-width:900px;margin:20px auto;padding:12px}
.card{
 background:white;border-radius:15px;
 padding:17px;margin-bottom:13px;
 box-shadow:0 3px 12px #172b4610
}
.stats{display:flex;justify-content:space-between}
.big{font-size:28px;font-weight:bold}
.muted{font-size:12px;color:#718096}
.track{
 height:8px;background:#e8edf2;
 border-radius:20px;overflow:hidden;margin-top:9px
}
.fill{height:100%;background:#d7b76d;width:0}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(245px,1fr));
 gap:12px
}
.subject{
 background:white;border:1px solid #e1e6ed;
 border-radius:14px;padding:15px;
 text-align:left;cursor:pointer;color:inherit;width:100%
}
.subject:hover{border-color:#8298b2}
.top{display:flex;align-items:center;gap:12px}
.ico{
 width:42px;height:42px;border-radius:12px;
 display:grid;place-items:center;color:white;font-size:20px
}
.name{font-weight:bold}
.code{font-size:11px;background:#eef2f6;padding:3px 7px;border-radius:20px}
.date{font-size:12px;color:#718096}
.percent{margin-left:auto;font-weight:bold}
.back{
 border:0;background:none;color:#365879;
 font-weight:bold;cursor:pointer;padding:10px 0
}
.panelhead{background:white;padding:17px;border-radius:15px}
.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:15px 0}
.tab{
 border:1px solid #ccd5e0;background:white;
 border-radius:30px;padding:9px 13px;cursor:pointer
}
.tab.active{background:#172b46;color:white}
.topic{padding:12px 0;border-bottom:1px solid #edf0f4}
.topic label{display:flex;gap:10px;align-items:flex-start;cursor:pointer}
.topic input{width:18px;height:18px;accent-color:#3975b9}
.topic.done .topicname{
 text-decoration:line-through;color:#8290a0
}
.revision{
 justify-content:flex-end;margin-top:8px;
 font-size:12px;color:#89749b
}
.revision input{width:14px;height:14px}
.btn{
 display:inline-block;background:#172b46;color:white;
 padding:10px 14px;border-radius:9px;
 text-decoration:none;font-size:13px;margin:5px 5px 5px 0
}
.btn.alt{background:white;color:#365879;border:1px solid #ccd5e0}
.note{font-size:12px;color:#718096;line-height:1.5}
footer{text-align:center;color:#8793a2;padding:20px;font-size:11px}
@media(max-width:520px){
 header h1{font-size:25px}
 .grid{grid-template-columns:1fr}
}
</style>
</head>

<body>
<header>
 <div>CBSE • BOARD EXAM 2027</div>
 <h1>My Class 10 Journey</h1>
 <p>Plan your portions. Track every chapter.</p>
</header>

<main>

<section id="dashboard">
 <div class="card">
  <div class="stats">
   <div><div class="big" id="overall">0%</div>
   <div class="muted">Overall preparation</div></div>
   <div style="text-align:right">
   <div class="big" id="counts">0/0</div>
   <div class="muted">Topics completed</div></div>
  </div>
  <div class="track"><div class="fill" id="overallbar"></div></div>
 </div>

 <h3>Examination Schedule</h3>
 <div class="grid" id="subjects"></div>

 <h3>CBSE Resources</h3>
 <div class="card">
  <b>Previous Year Question Papers</b>
  <p class="muted">Official CBSE question paper archive</p>
  <a class="btn"
  href="https://www.cbse.gov.in/cbsenew/question-paper.html"
  target="_blank">Open CBSE PYQ Page</a>
  <a class="btn alt"
  href="https://cbseacademic.nic.in/curriculum_2027.html"
  target="_blank">2026-27 Syllabus</a>
 </div>
</section>

<section id="detail" style="display:none">
 <button class="back" id="back">← All Subjects</button>

 <div class="panelhead">
  <h2 id="subjecttitle"></h2>
  <div class="muted" id="subjectmeta"></div>
  <div class="stats">
   <b id="subjectpercent">0%</b>
   <span class="muted" id="subjectcount"></span>
  </div>
  <div class="track">
   <div class="fill" id="subjectbar"></div>
  </div>
 </div>

 <h3>Select Portion</h3>
 <div class="tabs" id="tabs"></div>

 <div class="card">
  <h3 id="categorytitle"></h3>
  <div class="muted">Tick the topic after completing it.</div>
  <div id="topics"></div>
 </div>

 <a class="btn"
 href="https://www.cbse.gov.in/cbsenew/question-paper.html"
 target="_blank">Previous Year Questions</a>
 <a class="btn alt"
 href="https://cbseacademic.nic.in/curriculum_2027.html"
 target="_blank">Official Syllabus</a>

 <p class="note">
 Progress is saved automatically in this browser.
 </p>
</section>

<p class="note">
Use the official CBSE 2026-27 curriculum and your school's final
portion circular to verify the checklist.
</p>
</main>

<footer>CLASS X • CBSE BOARD EXAM PREPARATION • 2027</footer>

<script>

const subjects = [

{
